# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (for Groq multi-provider fallback)
GROQ_API_KEY=your_groq_api_key_here

# Multi-Provider Configuration
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# Fallback Configuration
ENABLE_AUTOMATIC_FALLBACK=true
GROQ_FALLBACK_MODEL=groq/llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_FALLBACK_MODEL=ollama/llama3.2

# Structured Logging Level
LOG_LEVEL=INFO

# --- Production Secret Management ---
# For production (K8s/Cloud), encode your local files to base64 and set these variables.
# Example: base64 -i credentials.json | pbcopy

# GOOGLE_CREDENTIALS_JSON=base64_encoded_content_of_credentials_json
# GMAIL_TOKEN_PICKLE=base64_encoded_content_of_token_pickle
